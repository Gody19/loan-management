APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# AI Services (optional, disabled by default)
# ---------------------------------------------------------------------------
# Master switch. When false (default) the application never calls any AI
# provider and every AI endpoint responds with a controlled "unavailable".
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_HISTORY_MESSAGES=12
# Per-user-per-minute limits for the chat and tool HTTP endpoints.
AI_CHAT_RATE_LIMIT=30
AI_TOOL_RATE_LIMIT=30
# Knowledge base (RAG) sizing. Disable to turn knowledge retrieval off.
AI_KNOWLEDGE_ENABLED=true
AI_KNOWLEDGE_CHUNK_SIZE=1200
AI_KNOWLEDGE_CHUNK_OVERLAP=150
AI_RAG_TOP_K=5
AI_RAG_MAX_CONTEXT_TOKENS=2000
# Embedding provider ('fake' is the deterministic offline default; 'openai' uses credentials below).
AI_EMBEDDING_PROVIDER=fake
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=256
AI_EMBEDDING_TIMEOUT=30
# Optional security-orientation system instruction. Empty disables it.
# AI_SYSTEM_INSTRUCTIONS=FinancePro AI assistant. Secure behavior required.

# OpenAI credentials (used only when AI_ENABLED=true and AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI embeddings (used only when AI_EMBEDDING_PROVIDER=openai)
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1

VITE_APP_NAME="${APP_NAME}"
